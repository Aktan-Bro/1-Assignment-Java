import java.util.Scanner;

public class TaskU {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int n = input.nextInt();
        int m = input.nextInt();

        int answer = (n % m == 0 || m % n == 0) ? 1 : 0;

        System.out.println(answer);
    }
}
