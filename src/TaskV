import java.util.Scanner;

public class TaskV {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int a = input.nextInt();
        int b = input.nextInt();

        int d = (a - b + 1000) / 1000;

        int answer = a * d + b * (1 - d);

        System.out.println(answer);
    }
}
