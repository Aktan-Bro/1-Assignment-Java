import java.util.Scanner;

public class TaskI {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int n = input.nextInt();

        int hundreds = n / 100;
        int tens = (n / 10) % 10;
        int ones = n % 10;

        int sum = hundreds + tens + ones;

        System.out.println(sum);
    }
}
