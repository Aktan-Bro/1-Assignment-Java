import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int a = input.nextInt();
        int b = input.nextInt();
        int n = input.nextInt();

        int total = (a * 100 + b) * n;

        int rubles = total / 100;
        int kopecks = total % 100;

        System.out.println(rubles + " " + kopecks);
    }
}
